---
// SPDX-License-Identifier: AGPL-3.0-only
import { commonTags } from "../ui/directory";
import { tools, hashtags } from "../lib/catalog";
import "../styles.css";
import { contentSecurityPolicy } from "../lib/security";
import { pageMetadata, siteName, toolPath } from "../lib/site";
import type { Tool } from "../lib/tool-types";

interface Props {
  tool?: Tool;
}
const { tool } = Astro.props;
const metadata = pageMetadata(tool);
const starterIds = [
  "json-format",
  "hash-workbench",
  "archive-workbench",
  "image-resize",
  "sql-runner",
  "python-runner",
];
const starterTools = starterIds.map((id) => {
  const tool = tools.find((tool) => tool.id === id);
  if (!tool) throw new Error(`Unknown start-page tool: ${id}`);
  return tool;
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content={contentSecurityPolicy(import.meta.env.DEV)}
    />
    <meta name="referrer" content="no-referrer" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metadata.title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={metadata.canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={metadata.title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={metadata.canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={metadata.title} />
    <meta name="twitter:description" content={metadata.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip" href="#search">
      Skip to search
    </a>
    <main class="page">
      <header>
        <div class="meta">
          <span>L5Z12-TOOLS-001</span>
          <span>REV. 01 / 2026</span>
        </div>
        <hr class="rule" />
        <div class="heading">
          <div class="site-brand">
            <a href="/" data-home>
              Tools
            </a>
          </div>
          <span class="muted mono">
            {tools.length} utilities / {hashtags.length} hashtags
          </span>
        </div>
        <p class="intro">
          Small tools for everyday work. Your inputs stay in this browser.
        </p>
        <p class="external-tools">
          Also by L5Z12:{" "}
          <a href="https://geoip.l5z12.dev">GeoIP — IP location lookup ↗</a>
        </p>
      </header>
      <section class="directory" aria-label="Tool directory">
        <div class="search-heading">
          <label for="search">Find a tool</label>
          <span class="muted mono">Ctrl / ⌘ K</span>
        </div>
        <input
          id="search"
          type="search"
          placeholder="Search tools, keywords, or #tags…"
          autocomplete="off"
          aria-describedby="search-help"
        />
        <nav id="tag-filters" class="groups" aria-label="Filter by hashtags">
          <button id="all-tags" type="button">
            All tools
          </button>
          {hashtags.map((tag) => (
            <button
              type="button"
              data-filter-tag={tag}
              aria-pressed="false"
              hidden={!commonTags.has(tag)}
            >
              #{tag}{" "}
              <span>{tools.filter((t) => t.tags.includes(tag)).length}</span>
            </button>
          ))}
        </nav>
        <button
          id="more-tags"
          type="button"
          class="link-button"
          aria-expanded="false"
          aria-controls="tag-filters"
        >
          All {hashtags.length} hashtags
        </button>
        <p id="search-help" class="muted filter-help">
          Combine hashtags to narrow results. Enter opens the first match; ↓
          moves into the list.
        </p>
        <button id="clear-search" class="link-button" type="button" hidden>
          Clear search & filters
        </button>
        <details id="index">
          <summary>
            <span>Browse the complete index</span>
            <span id="match-count" role="status" aria-live="polite">
              {tools.length} tools
            </span>
          </summary>
          <div id="tool-list" class="tool-results">
            {tools.map((t) => (
              <article data-tool-row={t.id}>
                <a href={toolPath(t.id)} data-tool={t.id}>
                  {t.name}
                </a>
                <p>{t.description}</p>
                <div class="tool-tags">
                  {t.tags.map((tag) => (
                    <button type="button" data-tag={tag}>
                      #{tag}
                    </button>
                  ))}
                </div>
              </article>
            ))}
          </div>
          <p id="no-results" hidden>
            No tools match these filters. Try a shorter search or clear the
            filters above.
          </p>
        </details>
        <nav
          id="recent-tools"
          class="recent-tools"
          aria-label="Recently used tools"
          hidden
        ></nav>
        <section
          id="start-page"
          aria-labelledby="start-title"
          hidden={Boolean(tool)}
        >
          <h1 id="start-title" tabindex="-1" class="view-title">
            Start here
          </h1>
          <p class="muted">
            Find a tool above, browse by hashtag, or jump into an everyday task.
          </p>
          <p id="route-message" role="status" hidden></p>
          <div class="starter-tools">
            {starterTools.map((tool) => (
              <a href={toolPath(tool.id)} data-tool={tool.id}>
                <strong>
                  {tool.name} <span aria-hidden="true">↗</span>
                </strong>
                <span class="muted">{tool.description}</span>
              </a>
            ))}
          </div>
        </section>
      </section>
      <section id="workspace" aria-labelledby="tool-title" hidden={!tool}>
        <div class="meta">
          <span id="tool-category">
            {tool?.tags?.map((tag) => `#${tag}`).join(" ")}
          </span>
          <span id="engine-status" role="status">
            Getting ready…
          </span>
        </div>
        <hr class="rule" />
        <div class="workspace-heading">
          <h1 id="tool-title" tabindex="-1" class="view-title">
            {tool?.name}
          </h1>
          <div>
            <a href="/" class="link-button" data-home>
              Home
            </a>
            <button id="find-tool" class="link-button" type="button">
              Find another tool
            </button>
            <button id="copy-tool-link" class="link-button" type="button">
              Copy link
            </button>
          </div>
        </div>
        <p id="description" class="muted">
          {tool?.description}
        </p>
        <noscript>
          <p>Enable JavaScript to run these tools locally in your browser.</p>
        </noscript>
        <form id="tool-form" hidden>
          <div class="field-header">
            <label for="input">Input</label>
            <div>
              <button type="button" id="example" class="link-button">
                Load example
              </button>
              <button type="button" id="undo-clear" class="link-button" hidden>
                Restore text
              </button>
              <button type="button" id="clear" class="link-button">
                Clear
              </button>
            </div>
          </div>
          <textarea
            id="input"
            rows="7"
            spellcheck="false"
            autocomplete="off"
            autocapitalize="off"
            aria-describedby="description"
          ></textarea>
          <p
            id="input-summary"
            title="Recent text inputs are kept in this tab while you switch tools. Reloading clears them."
            class="input-summary muted mono"
          ></p>
          <div id="file-field" hidden>
            <label for="file">Choose file (maximum 32 MB)</label>
            <input id="file" type="file" />
          </div>
          <div id="animation-options" hidden>
            <p class="muted">
              Frames fit the first image’s canvas. Adjust the order and duration
              (milliseconds) below.
            </p>
            <div id="frames"></div>
            <label for="animation-loops">Loop count (0 = forever)</label>
            <input
              id="animation-loops"
              type="number"
              min="0"
              max="65535"
              value="0"
            />
            <div id="fallback-options" hidden>
              <label for="fallback-file">
                Static fallback image (optional)
              </label>
              <input
                id="fallback-file"
                type="file"
                accept="image/png,image/jpeg,image/webp"
              />
              <label for="fallback-color">Fallback background</label>
              <input id="fallback-color" type="color" value="#ffffff" />
              <p class="muted">
                APNG viewers show the main image; static PNG viewers show the
                fallback. Both images are readable from the file. Image
                optimization or conversion may remove this behavior.
              </p>
            </div>
          </div>
          <div id="option-field" hidden>
            <label for="option" id="option-label">
              Options
            </label>
            <textarea id="option" rows="2" spellcheck="false"></textarea>
            <select id="unit-select" hidden aria-label="Input unit"></select>
          </div>
          <div id="suite-controls" hidden></div>
          <label
            class="suite-checkbox"
            id="bypass-limits-field"
            for="bypass-limits"
          >
            <input id="bypass-limits" type="checkbox" />
            Bypass size, quantity, and time limits
          </label>
          <p id="bypass-limits-help" class="muted">
            May use large amounts of memory and freeze this tab. Stop still
            works where a Stop button is shown.
          </p>
          <div class="actions">
            <button id="run" class="primary" disabled>
              <span id="run-label">Run tool</span>{" "}
              <span aria-hidden="true">→</span>
            </button>
            <span class="muted">Ctrl / ⌘ + Enter</span>
          </div>
        </form>
        <p id="error" role="alert" tabindex="-1" hidden></p>
        <div class="field-header">
          <label for="output">Result</label>
          <div>
            <button id="copy" class="link-button" disabled>
              Copy
            </button>
            <button id="download" class="link-button" disabled>
              Download
            </button>
          </div>
        </div>
        <div id="empty-result" class="empty-result">
          <p>Your result will appear here.</p>
          <span class="muted">
            Choose your input and options, then run the tool.
          </span>
        </div>
        <div id="output-format-controls" class="output-format-controls"></div>
        <div id="result-view" class="result-view" hidden></div>
        <button id="toggle-raw" class="link-button" hidden>
          Show raw output
        </button>
        <textarea
          id="output"
          hidden
          rows="7"
          readonly
          spellcheck="false"
          aria-label="Result"
          placeholder="Your result will appear here."
        ></textarea>
        <p class="muted result-meta" id="result-status" role="status">
          All calculations run locally. No account required.
        </p>
      </section>
      <footer>
        <span>© l5z12</span>
        <span aria-hidden="true">/</span>
        <a href="/LICENSE">AGPL-3.0</a>
        <span aria-hidden="true">/</span>
        <a href="https://github.com/l5z12/tools">GitHub</a>
        <span aria-hidden="true">/</span>
        <a href="https://geoip.l5z12.dev">GeoIP</a>
        <span aria-hidden="true">/</span>
        <button id="theme" class="link-button">
          Theme: Auto
        </button>
        <span class="footer-note">Astro + Rust / WebAssembly</span>
      </footer>
    </main>
    <script src="../client.ts"></script>
  </body>
</html>
